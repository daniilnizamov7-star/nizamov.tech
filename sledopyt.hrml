<script>
const obs=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in')})},{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

let mOpen=false;
function toggleBurger(){
  mOpen=!mOpen;
  let m=document.getElementById('mob-nav');
  if(mOpen){
    if(!m){
      m=document.createElement('div');
      m.id='mob-nav';
      m.style.cssText='position:fixed;top:64px;left:0;right:0;background:#0A150B;border-bottom:1px solid rgba(74,222,128,.08);padding:20px 28px;z-index:99;display:flex;flex-direction:column;gap:16px';
      [['Как играть','#how'],['Возможности','#features'],['Роли','#roles'],['Система очков','#scoring']].forEach(([l,h])=>{
        const a=document.createElement('a');
        a.href=h;a.textContent=l;
        a.style.cssText='font-size:17px;font-weight:500;color:#7A9B7A';
        a.onclick=()=>toggleBurger();
        m.appendChild(a);
      });
      document.body.appendChild(m);
    } else m.style.display='flex';
  } else if(m) m.style.display='none';
}

function navigate(url){
  document.body.style.pointerEvents='none';
  document.body.classList.add('page-out');
  setTimeout(()=>window.location.href=url,260);
}
document.querySelectorAll('a[href]').forEach(a=>{
  const href=a.getAttribute('href');
  if(href&&!href.startsWith('#')&&!href.startsWith('http')&&!href.startsWith('tel')&&!a.target){
    a.addEventListener('click',e=>{e.preventDefault();navigate(href)});
  }
});
</script>
